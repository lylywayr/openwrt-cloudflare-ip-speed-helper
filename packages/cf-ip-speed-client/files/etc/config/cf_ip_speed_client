config client 'main'
	option enabled '0'
	option ip_mode 'dual'
	option include_443 '1'
	option custom_ports ''
	option test_url 'https://speed.cloudflare.com/__down?bytes=10485760'
	option schedule_mode 'daily'
	option interval_hours '6'
	option daily_hour '3'
	option daily_minute '0'
	option log_clear_interval 'weekly'
	option result_file '/tmp/cf-ip-speed-client/result.csv'
	option deploy_platform 'cloudflare'
	option deploy_repo 'cloudflare-ip-speed-results'
	option deploy_branch 'main'
	option deploy_filename 'ADD.txt'
	option deploy_enabled '0'
	option edgetunnel_sync_enabled '0'
	option edgetunnel_sync_url ''
	option edgetunnel_sync_password ''
	option edgetunnel_sync_v4_count '20'
	option edgetunnel_sync_v6_count '10'
	option cf_pages_project 'cloudflare-ip-speed-results'
	option cf_pages_subdomain 'cfip'
	option cf_pages_domain_mode 'pages'
	option cf_pages_zone ''
